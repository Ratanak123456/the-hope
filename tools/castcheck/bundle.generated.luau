		box(cutter, "SupportRing", V(3.7, 1, 1), HEAD_REST * r * CF(0, -1.7, 4.5), PAINT_DARK)
		if i % 2 == 0 then
			box(cutter, "RingStrut", V(0.6, 3.6, 0.6), HEAD_REST * r * CF(0, -0.2, 3.6), STEEL)
			box(cutter, "RingSpoke", V(0.5, 0.5, 1.6), HEAD_REST * r * CF(0, 1.3, 3.3), STEEL)
		end
	end
