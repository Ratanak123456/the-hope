  smoke.Parent=env.folder
  local flashLight=Kit.light(core,Color3.fromRGB(255,235,200),0,0)
  local sparks=Kit.dust(core,0,Color3.fromRGB(255,200,120),18)
  sparks.Lifetime=NumberRange.new(0.35,0.85)
