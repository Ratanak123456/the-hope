   e.core.Size=V(1,1,1)*Kit.lerp(2,9,t)
  elseif a<0.16 then
   -- T=0.07-0.30s: the hot core stays readable while the orange fire volume
   -- expands around it - a fireball with a structure, not a flat disc.
