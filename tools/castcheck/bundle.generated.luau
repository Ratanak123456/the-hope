 end
 for i=1,4 do
  local frost=attach(r,r.torso,"IceFracture",V(1.6,1.2,0.4)*s,cf(i%2==0 and 1 or -1,1-i*0.5,-1)*A(0,0,i*0.4),C.ice,"wedge",Enum.Material.Ice)
  frost.Transparency=0.5;table.insert(r.ice,frost)
 end
