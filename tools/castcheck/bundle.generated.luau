		local band = box(mast, "MastScale", V(1.78, 0.18, 1.78), HEAD_REST * CF(0, 4.2 + i * 5, 0), HIVIS)
		band.CanQuery = false
	end

	local cutter = Kit.model("CutterHead", model)
