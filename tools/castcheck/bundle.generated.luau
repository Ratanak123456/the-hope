 cylinder(station,"CableDrum",V(2.2,3,3),CF(x+V(-7,ROOF_TOP+1.5,0.6)),C.dark)
 cable(station,x+V(-7,ROOF_TOP+1.4,2),x+V(-2,ROOF_TOP+1.4,hz-5),0.6)
 crate(station,CF(x+V(7,ROOF_TOP+1.2,-6)),V(2.8,2.4,2.8))
