		box(cutter, "SectorTeeth", V(2.3, 0.5, 0.6), sector * CF(0, -1.2, 1.1), DARK)
	end
	box(cutter, "HeadNose", V(2.6, 1.2, 2.6), HEAD_REST * CF(0, -3.7, 0), DARK)
