		FogEnd = 300,
	}, {
		Haze = 2.2,
		Glare = 0.05 * a,
		Color = Color3.fromRGB(200, 170, 120),
		Decay = Color3.fromRGB(30, 26, 20),
	}, nil, {
		Brightness = -0.03,
		Contrast = 0.14,
		Saturation = -0.1,
		TintColor = Color3.fromRGB(255, 224, 190):Lerp(Color3.fromRGB(255, 200, 150), a),
