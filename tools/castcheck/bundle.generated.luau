  part(root,"NearIceRidge",V(rng:NextNumber(18,34),h,rng:NextNumber(20,40)),CF(o+V(x,h*0.34-3,z))*A(0,rng:NextNumber(-0.6,0.6),side*0.09),C.ice:Lerp(C.snow,rng:NextNumber(0.3,0.8)),Enum.Material.Ice,"wedge")
